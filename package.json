{
  "name": "express-redis-cache2",
  "version": "2.0.0-beta5",
  "description": "A module to make Express interact with Redis (create, get, delete). You can automatically cache all your most popular routes in Redis.",
  "main": "index.js",
  "types": "index.d.ts",
  "scripts": {
    "test": "jest --detectOpenHandles",
    "run-tests": "yarn global add --frozen-lockfile --global-folder=node_modules redis@4 && docker-compose up -d && docker-compose logs -f tests && docker-compose down",
    "gimtoc": "gimtoc -f README.md -s 'Table of Contents' -o README.md && git diff README.md"
  },
